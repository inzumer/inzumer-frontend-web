---
import { RichText } from '@inzumer/ui-library';
import { COOKIES_HASH } from '@components/organisms/ConsentManager';
import { getTranslations } from '@i18n';
import { interpolate, localizedPath, trackingProps, type Locale } from '@utils';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const { footer, footerLinks } = getTranslations(lang, 'common');
const linkClass =
  'inline-flex min-h-11 items-center underline-offset-4 hover:underline focus-visible:rounded-sm focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-(--border-focus)';
---

<footer class="mt-24 flex flex-col items-center gap-2 border-t border-(--border-default) px-6 py-10 pb-[calc(4rem_+_env(safe-area-inset-bottom))] text-center">
  <RichText variant="p4" weight="light" className="text-(--text-tertiary)">
    {interpolate(footer.disclaimer, { year: new Date().getFullYear() })}
  </RichText>
  <nav class="flex gap-6 text-[1.3rem] font-light text-(--text-tertiary)">
    <a
      {...trackingProps('footer', 'link', 'privacy')}
      href={localizedPath(lang, 'privacy')}
      class={linkClass}
    >
      {footerLinks.privacy}
    </a>
    <a {...trackingProps('footer', 'link', 'cookies')} href={COOKIES_HASH} class={linkClass}>
      {footerLinks.cookies}
    </a>
  </nav>
</footer>
