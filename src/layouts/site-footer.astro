---
import { RichText } from '@inzumer/ui-library';
import { getTranslations } from '@i18n';
import { interpolate, type Locale } from '@utils';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const { footer } = getTranslations(lang, 'common');
---

<footer class="mt-24 border-t border-(--border-default) px-6 py-10 pb-[calc(4rem_+_env(safe-area-inset-bottom))] text-center">
  <RichText variant="p4" weight="light" className="text-(--text-tertiary)">
    {interpolate(footer.disclaimer, { year: new Date().getFullYear() })}
  </RichText>
</footer>
