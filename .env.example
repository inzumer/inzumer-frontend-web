# Resend API key with sending access; the inzumer.com domain must be verified in Resend.
# Set it in Vercel; never commit it.
RESEND_API_KEY=

# Sentry: the DSN is public (it goes in the browser bundle); without it Sentry stays off.
PUBLIC_SENTRY_DSN=
# Source map upload at build time; keep the token only in Vercel.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
